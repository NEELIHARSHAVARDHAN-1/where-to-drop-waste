# Server
PORT=4000
NODE_ENV=development

# JWT Secret — CHANGE THIS IN PRODUCTION
JWT_SECRET=your_jwt_secret_here_change_in_production

# Database
DB_PATH=./data/waste_app.db

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# TensorFlow / Teachable Machine Model
# Place model files in: backend/models/teachable_machine/
# Required: model.json + weights.bin + metadata.json  (TF.js export)
#   OR:     model.tflite + metadata.json              (TFLite export)
TF_MODEL_DIR=./models/teachable_machine
TF_CONFIDENCE_THRESHOLD=0.70

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
