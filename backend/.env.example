# Server Configuration
PORT=4000
NODE_ENV=development

# Appwrite
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_STORAGE_BUCKET_ID=

# Optional: Appwrite collection IDs
APPWRITE_COL_PROFILES=profiles
APPWRITE_COL_CLASSIFICATIONS=classifications
APPWRITE_COL_IMPACTS=impacts
APPWRITE_COL_BADGES=badges
APPWRITE_COL_USER_BADGES=user_badges
APPWRITE_COL_CHALLENGES=challenges
APPWRITE_COL_USER_CHALLENGES=user_challenges
APPWRITE_COL_LOCAL_RULES=local_rules
APPWRITE_COL_ECO_TIPS=eco_tips
APPWRITE_COL_WASTE_ITEMS=waste_items
APPWRITE_COL_USER_CORRECTIONS=user_corrections
APPWRITE_COL_TRAINING_CANDIDATES=training_candidates
APPWRITE_COL_ADMIN_USERS=admin_users

# CORS
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=

# Upload & Model
MAX_FILE_SIZE_MB=5
TF_CONFIDENCE_THRESHOLD=0.70